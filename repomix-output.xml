	var facing_sign = sign(direction)
	if facing_sign == 0:
		return

	if is_instance_valid(spine_sprite):
		spine_sprite.scale.x = abs(spine_sprite.scale.x) * facing_sign
	
	if is_instance_valid(wall_detector):
